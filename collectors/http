#!/usr/bin/env python3
"""Whether the web addresses of running nodes answer: http_up{project,node,url} 1 or 0, and
http_seconds{...} for the ones that do. Every `links:` entry of a running node that starts with
http:// or https:// is fetched once a minute (5 s timeout)."""
import os
import re
import time
import urllib.request
from pathlib import Path

home = Path(os.environ.get("OPS_HOME", Path.home() / "ops"))
for path in home.glob("projects/*/nodes/*.yaml"):
    text = path.read_text()
    if not re.search(r"^status: running$", text, re.M):
        continue
    for url in re.findall(r"^- (https?://\S+)$", text, re.M):
        labels = f'project="{path.parent.parent.name}",node="{path.stem}",url="{url}"'
        start = time.time()
        try:
            request = urllib.request.Request(url, headers={"User-Agent": "ops-http-collector"})
            ok = urllib.request.urlopen(request, timeout=5).status < 400
        except Exception:
            ok = False
        print(f"http_up{{{labels}}} {1 if ok else 0}")
        if ok:
            print(f"http_seconds{{{labels}}} {time.time() - start:.3f}")
