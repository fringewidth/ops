#!/usr/bin/env python3
"""Liveness of every running claim on this host: ops_claim_alive{project,node} 1 or 0."""
import os
import socket
from pathlib import Path

import re

home = Path(os.environ.get("OPS_HOME", Path.home() / "ops"))
host = socket.gethostname()
for path in home.glob("projects/*/nodes/*.yaml"):
    text = path.read_text()
    if not re.search(r"^status: running$", text, re.M) or f"host: {host}" not in text:
        continue
    pid = re.search(r"^\s+pid: (\d+)$", text, re.M)
    if not pid:
        continue
    try:
        os.kill(int(pid.group(1)), 0)
        state = 1
    except ProcessLookupError:
        state = 0
    except PermissionError:
        state = 1
    print(f'ops_claim_alive{{project="{path.parent.parent.name}",node="{path.stem}"}} {state}')
