#!/usr/bin/env python3
"""Mac load: GPU utilization and memory (ioreg, no sudo), CPU load, RAM in use."""
import re
import subprocess
import sys

if sys.platform != "darwin":
    sys.exit(0)
accel = subprocess.run(["ioreg", "-r", "-d", "1", "-w", "0", "-c", "IOAccelerator"], capture_output=True, text=True).stdout
for key, name in [("Device Utilization %", "gpu_util_percent"), ("Renderer Utilization %", "gpu_renderer_percent"), ("In use system memory", "gpu_mem_bytes")]:
    match = re.search(rf'"{key}"=(\d+)', accel)
    if match:
        print(f"{name} {match.group(1)}")
load = subprocess.run(["sysctl", "-n", "vm.loadavg"], capture_output=True, text=True).stdout.split()
print(f"cpu_load1 {load[1]}")
page = int(subprocess.run(["sysctl", "-n", "hw.pagesize"], capture_output=True, text=True).stdout)
total = int(subprocess.run(["sysctl", "-n", "hw.memsize"], capture_output=True, text=True).stdout)
stats = dict(re.findall(r"^(.+?):\s+(\d+)\.", subprocess.run(["vm_stat"], capture_output=True, text=True).stdout, re.M))
used = (int(stats["Pages active"]) + int(stats["Pages wired down"]) + int(stats.get("Pages occupied by compressor", 0))) * page
print(f"mem_used_bytes {used}")
print(f"mem_total_bytes {total}")
